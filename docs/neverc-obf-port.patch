+// Minimal printf-family varargs fixup: normalize/decrypt pointer-like varargs
+static inline void vm_fixup_printf_varargs(VMState *vm, void *fn, uint8_t argc, int64_t *argv)
+{
+    const char *fmt = NULL;
+    int fixed = 0;
+    if (fn == (void *)&snprintf)
+    {
+        if (argc < 3)
+            return;
+        fmt = (const char *)(uintptr_t)argv[2];
+        fixed = 3;
+    }
+    else if (fn == (void *)&fprintf)
+    {
+        if (argc < 2)
+            return;
+        fmt = (const char *)(uintptr_t)argv[1];
+        fixed = 2;
+    }
+    else if (fn == (void *)&printf)
+    {
+        if (argc < 1)
+            return;
+        fmt = (const char *)(uintptr_t)argv[0];
+        fixed = 1;
+    }
+    else
+    {
+        return; // non-printf family
+    }
+
+    if (!fmt)
+        return;
+
+    // Parse format and fix up pointer varargs for %s and %p
+    int var_i = 0; // index into varargs tail
+    for (const char *p = fmt; *p; ++p)
+    {
+        if (*p != '%')
+            continue;
+        ++p;
+        if (*p == '%')
+            continue; // escaped '%%'
+        // Flags
+        while (*p && strchr("-+ #0", *p))
+            ++p;
+        // Width
+        if (*p == '*')
+        {
+            // consume one int argument
+            var_i++;
+            ++p;
+        }
+        else
+        {
+            while (*p && (*p >= '0' && *p <= '9'))
+                ++p;
+        }
+        // Precision
+        if (*p == '.')
+        {
+            ++p;
+            if (*p == '*')
+            {
+                var_i++;
+                ++p;
+            }
+            else
+            {
+                while (*p && (*p >= '0' && *p <= '9'))
+                    ++p;
+            }
+        }
+        // Length modifiers (we ignore exact type here)
+        while (*p && strchr("hljztL", *p))
+            ++p;
+        if (!*p)
+            break;
+        char spec = *p;
+        // Decide if this vararg expects a pointer
+        int is_ptr_va = (spec == 's' || spec == 'p');
+        int idx = fixed + var_i;
+        if (idx < (int)argc)
+        {
+            if (is_ptr_va)
+            {
+                int64_t v = argv[idx];
+                // Convert tagged local to real pointer
+                if (v < 0)
+                {
+                    size_t off = (size_t)(-v - 1);
+                    argv[idx] = (int64_t)(intptr_t)&vm->local_mem[off];
+                    v = argv[idx];
+                }
+                // Decrypt if this equals an encrypted table entry
+                if (&vm_data_table && &vm_data_table_size)
+                {
+                    uintptr_t pv = (uintptr_t)v;
+                    for (int k = 0; k < vm_data_table_size; ++k)
+                    {
+                        if ((uintptr_t)vm_data_table[k] == pv)
+                        {
+                            int is_enc = 0;
+                            if (&vm_data_is_enc)
+                                is_enc = vm_data_is_enc[k] ? 1 : 0;
+                            else if (&vm_data_len)
+                                is_enc = vm_data_len[k] > 0 ? 1 : 0;
+                            if (is_enc)
+                            {
+                                uint8_t *stable = vm_decrypt_item_cached(vm, (uint16_t)k);
+                                argv[idx] = (int64_t)(intptr_t)stable;
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        // Advance varargs index for this conversion
+        var_i++;
+    }
+}
