+    case 7: return "SIToFP";case 8: return "FPTrunc";case 9: return "FPExt";
+    case 10:return "PtrToInt";case 11:return "IntToPtr";case 12:return "BitCast";
+    case 13:return "AddrSpaceCast";
+    default:return "?";
+  }
+}
