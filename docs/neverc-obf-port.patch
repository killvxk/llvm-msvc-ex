+// SHA256
+/* Various logical functions */
+#define Ch(x, y, z) (z ^ (x &(y ^ z)))
+#define Maj(x, y, z) (((x | y) & z) | (x &y))
+// PORT-OBF: renamed S -> CU_S; the single-letter function-like macro collided
+// with parameter names in NeverC's vendored LLVM headers (raw_ostream.h,
+// SourceMgr.h, VirtualFileSystem.h) when this header is included first.
+#define CU_S(x, n) RORc((x), (n))
+#define R1(x, n) (((x) & 0xFFFFFFFFUL) >> (n))
+#define Sigma0(x) (CU_S(x, 2) ^ CU_S(x, 13) ^ CU_S(x, 22))
+#define Sigma1(x) (CU_S(x, 6) ^ CU_S(x, 11) ^ CU_S(x, 25))
+#define Gamma0(x) (CU_S(x, 7) ^ CU_S(x, 18) ^ R1(x, 3))
+#define Gamma1(x) (CU_S(x, 17) ^ CU_S(x, 19) ^ R1(x, 10))
+#define MIN(x, y) (((x) < (y)) ? (x) : (y))
+
+#define RND(a, b, c, d, e, f, g, h, i, ki)                                     \
+  t0 = h + Sigma1(e) + Ch(e, f, g) + ki + W[i];                                \
+  t1 = Sigma0(a) + Maj(a, b, c);                                               \
+  d += t0;                                                                     \
+  h = t0 + t1;
+
+#define RORc(x, y)                                                             \
+  (((((unsigned long)(x) & 0xFFFFFFFFUL) >> (unsigned long)((y) & 31)) |       \
+    ((unsigned long)(x) << (unsigned long)(32 - ((y) & 31)))) &                \
+   0xFFFFFFFFUL)
