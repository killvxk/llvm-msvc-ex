index 000000000..801739fbd
--- /dev/null
+++ b/llvm/lib/Obfuscation/Eigen/src/QR/HouseholderQR.h
@@ -0,0 +1,434 @@
+// This file is part of Eigen, a lightweight C++ template library
+// for linear algebra.
