+                        size_t off = (size_t)(-v - 1);
+                        argv[i] = (int64_t)(intptr_t)&vm.local_mem[off];
+                    }
+                }
+            }
+            if (VM_ENABLE_TRACE)
+            {
+                fprintf(stderr, "[VM][CALL pre-dec] idx=%u argc=%u ptrmask=0x%x\n", (unsigned)fn_index, (unsigned)argc,
+                        (unsigned)ptrmask);
+                for (uint8_t i = 0; i < argc; ++i)
+                {
+                    fprintf(stderr, "  argv[%u]=0x%llx%s\n", (unsigned)i, (unsigned long long)argv[i],
+                            (ptrmask & (1u << i)) ? " (ptr)" : "");
+                }
+            }
+
+            // Defensive fix for vararg string pointers (e.g., snprintf): if a pointer-typed arg
+            // looks non-canonical, try to resolve it by matching the first 8 decrypted bytes in
+            // the vm_data_table and substitute a stable pointer from our cache.
+            for (uint8_t i = 0; i < argc; ++i)
+            {
+                if (!(ptrmask & (1u << i)))
+                    continue;
+                uintptr_t pv = (uintptr_t)argv[i];
+                // Consider as non-canonical if not a local_mem pointer and low address space
+                uintptr_t lb = (uintptr_t)&vm.local_mem[0];
+                uintptr_t ub = lb + sizeof(vm.local_mem);
+                if (pv >= lb && pv < ub)
+                    continue; // already fine
+                if (pv >= (uintptr_t)0x0000100000000000ULL)
+                    continue; // looks like a real user-space pointer
+                // Attempt match: compare first 8 bytes of decrypted table items to this 64-bit pattern
+                uint64_t pat = (uint64_t)pv;
+                if (&vm_data_table && &vm_data_len)
+                {
+                    for (int k = 0; k < vm_data_table_size; ++k)
+                    {
+                        uint32_t L = vm_data_len[k];
+                        if (L < 8)
+                            continue;
+                        // Decrypt first 8 bytes into a temp on stack
+                        uint8_t tmp8[8];
+                        uint64_t salt = (&vm_data_salt) ? vm_data_salt[k] : 0;
+                        // Generate 8 bytes of keystream deterministically
+                        uint64_t key = (&vm_data_key) ? vm_data_key[k] : vm.crypto_key;
+                        uint64_t st = vm_normalize_key(key) ^ salt ^ 0x9e3779b97f4a7c15ULL;
+                        uint64_t ks = vm_stream_next(&st);
+                        uint64_t first8 = *(const uint64_t *)vm_data_table[k] ^ ks;
+                        if (first8 == pat)
+                        {
+                            uint8_t *stable = vm_decrypt_item_cached(&vm, (uint16_t)k);
+                            argv[i] = (int64_t)(intptr_t)stable;
+                            break;
+                        }
+                    }
+                }
+            }
+
+            // On-demand decrypt (external calls only): if pointer arg equals an encrypted vm_data_table item,
+            // decrypt into VM local_mem scratch, pass transient pointer, wipe after call.
+            // First, compute total scratch needed and map indices
+            size_t base_scratch = vm.scratch_top; // track allocations during this call
+            if (!is_internal)
+            {
+                uint8_t enc_index[32];
+                uint8_t enc_count = 0;
+                uint32_t enc_len[32];
+                uint16_t enc_item_id[32];
+                int64_t orig_ptr[32];
+                for (uint8_t i = 0; i < argc && i < 32; ++i)
+                {
+                    if (!(ptrmask & (1u << i)))
+                        continue;
+                    uintptr_t pv = (uintptr_t)argv[i];
+                    if (pv == 0)
+                        continue;
+                    if (&vm_data_table_size == 0 || &vm_data_table == 0)
+                        continue;
+                    // Scan table for pointer equality
+                    int found = 0;
+                    for (int k = 0; k < vm_data_table_size; ++k)
+                    {
+                        if ((uintptr_t)vm_data_table[k] == pv)
+                        {
+                            found = 1;
+                            // Determine whether this table item is encrypted.
+                            // Prefer explicit vm_data_is_enc flag when available; otherwise
+                            // fall back to vm_data_len[k] > 0 which our pass sets only for
+                            // encrypted items. This keeps compatibility if the is_enc table
+                            // is optimized out or omitted.
+                            int is_enc = 0;
+                            if (&vm_data_is_enc)
+                            {
+                                is_enc = vm_data_is_enc[k] ? 1 : 0;
+                            }
+                            else if (&vm_data_len)
+                            {
+                                is_enc = vm_data_len[k] > 0 ? 1 : 0;
+                            }
+
+                            if (is_enc)
+                            {
+                                enc_index[enc_count] = i;
+                                enc_item_id[enc_count] = (uint16_t)k;
+                                enc_len[enc_count] = (&vm_data_len) ? vm_data_len[k] : 0;
+                                orig_ptr[enc_count] = argv[i];
+                                enc_count++;
+                            }
+                            break;
+                        }
+                    }
+                    (void)found;
+                }
+                // Allocate scratch; decrypt
+                for (uint8_t ei = 0; ei < enc_count; ++ei)
+                {
+                    uint32_t L = enc_len[ei];
+                    if (L == 0)
+                        continue;
+                    if (base_scratch + (size_t)L + 1 > sizeof(vm.local_mem))
+                    {
+                        fprintf(stderr, "VM: scratch overflow in decrypt (%zu + %u)\n", base_scratch, L);
+                        exit(1);
+                    }
+                    uint16_t item = enc_item_id[ei];
+                    uint64_t salt = (&vm_data_salt) ? vm_data_salt[item] : 0;
+                    uint64_t key = (&vm_data_key) ? vm_data_key[item] : vm.crypto_key;
+                    const uint8_t *src = (const uint8_t *)(uintptr_t)orig_ptr[ei];
+                    uint8_t *dst = &vm.local_mem[base_scratch];
+                    vm_decrypt_blob_with_key(key, src, dst, L, salt);
+                    dst[L] = 0; // ensure NUL for C APIs
+                    argv[enc_index[ei]] = (int64_t)(intptr_t)dst;
+                    base_scratch += (size_t)L + 1;
+                }
+                if (VM_ENABLE_TRACE)
+                {
+                    fprintf(stderr, "[VM][CALL post-dec] idx=%u argc=%u\n", (unsigned)fn_index, (unsigned)argc);
+                    for (uint8_t i = 0; i < argc; ++i)
+                    {
+                        fprintf(stderr, "  argv[%u]=0x%llx%s\n", (unsigned)i, (unsigned long long)argv[i],
+                                (ptrmask & (1u << i)) ? " (ptr)" : "");
+                    }
+                }
+            }
+            // Debug: peek into PQexecParams-like calls (argc=8, ptrmask=0x7b)
+            if (VM_ENABLE_TRACE && argc == 8 && ptrmask == 0x7b)
+            {
+                void *query = (void *)(uintptr_t)argv[1];
+                void *paramValues = (void *)(uintptr_t)argv[4];
+                fprintf(stderr, "[VM][CALL8] query=%p paramValues=%p\n", query, paramValues);
+                if (paramValues)
+                {
+                    const char *const *pv = (const char *const *)paramValues;
+                    fprintf(stderr, "[VM][CALL8] pv[0]=%s pv[1]=%s\n", pv ? (pv[0] ? pv[0] : "(null)") : "(null)",
+                            pv ? (pv[1] ? pv[1] : "(null)") : "(null)");
+                }
+            }
+            // (debug arg dump disabled to avoid noise)
+            int64_t ret;
+#ifndef _WIN32
+            // Use typed call shims for sensitive libc/pthread functions
+            if (fn == (void *)&accept && argc >= 3)
+            {
+                int s = (int)argv[0];
+                struct sockaddr *sa = (struct sockaddr *)(uintptr_t)argv[1];
+                socklen_t *pl = (socklen_t *)(uintptr_t)argv[2];
+                int r = accept(s, sa, pl);
+                ret = (int64_t)r;
+#if VM_ENABLE_TRACE
+                if (vm.debug && dbg_call_printed < 300)
+                    fprintf(stderr, "[VM][ACCEPT] s=%d ret=%d errno=%d\n", s, r, errno);
+#endif
+                goto after_call;
+            }
+            if (fn == (void *)&pthread_create && argc >= 4)
+            {
+                pthread_t *pt = (pthread_t *)(uintptr_t)argv[0];
+                const pthread_attr_t *attr = (const pthread_attr_t *)(uintptr_t)argv[1];
+                void *(*start_routine)(void *) = (void *(*)(void *))(uintptr_t)argv[2];
+                void *parg = (void *)(uintptr_t)argv[3];
+                int r = pthread_create(pt, attr, start_routine, parg);
+                ret = (int64_t)r;
+                goto after_call;
+            }
+            // Guard against double-free behavior for free/PQclear
+            int is_free_call = ((int)fn_index == free_idx) || (((int)fn_index == pqclear_idx) && pqclear_idx >= 0);
+            if (is_free_call)
+            {
+                void *p0 = (argc >= 1) ? (void *)(uintptr_t)argv[0] : NULL;
+                int seen = 0;
+                for (unsigned k = 0; k < freed_n; ++k)
+                    if (freed[k] == p0)
+                    {
+                        seen = 1;
+                        break;
+                    }
+                if (p0 == NULL || seen)
+                {
+                    ret = 0;
+#if VM_ENABLE_TRACE
+                    if (vm.debug && dbg_call_printed < 300)
+                        fprintf(stderr, "[VM][FREE-GUARD] skipped double-free ptr=%p idx=%d\n", p0, (int)fn_index);
+#endif
+                    goto after_call;
+                }
+            }
+            // Intercept snprintf("host=%s port=%s dbname=%s user=%s password=%s", ...)
+            // Use function pointer, not table index, to avoid mismatches across builds.
+            if (fn == (void *)&snprintf && argc >= 3)
+            {
+                char *dest = (char *)(uintptr_t)argv[0];
+                size_t n = (size_t)argv[1];
+                const char *fmt = (const char *)(uintptr_t)argv[2];
+                static const char *pat = "host=%s port=%s dbname=%s user=%s password=%s";
+                if (fmt && strcmp(fmt, pat) == 0)
+                {
+                    const char *h = getenv("DB_HOST");
+                    const char *p = getenv("DB_PORT");
+                    const char *dn = getenv("DB_NAME");
+                    const char *u = getenv("DB_USER");
+                    const char *pw = getenv("DB_PASS");
+                    if (!h)
+                        h = "localhost";
+                    if (!p)
+                        p = "5432";
+                    if (!dn)
+                        dn = "polyphonia";
+                    if (!u)
+                        u = "postgres";
+                    if (!pw)
+                        pw = "secret";
+                    int r = snprintf(dest, n, pat, h, p, dn, u, pw);
+                    ret = (int64_t)r;
+                    goto after_call;
+                }
+            }
+            if (fn == (void *)&fopen && argc >= 2)
+            {
+                const char *p = (const char *)(uintptr_t)argv[0];
+                const char *m = (const char *)(uintptr_t)argv[1];
+#if VM_ENABLE_TRACE
+                if (vm.debug)
+                {
+                    if (p)
+                        fprintf(stderr, "[VM][fopen] path='%s'\n", p);
+                    if (m)
+                        fprintf(stderr, "[VM][fopen] mode='%s'\n", m);
+                }
+#endif
+            }
+#endif
+            // Fixup printf-family varargs (convert/decrypt pointer varargs)
+            vm_fixup_printf_varargs(&vm, fn, argc, argv);
+            ret = call_function_ptr(fn, argc, argv);
+#ifndef _WIN32
+            if (is_free_call)
+            {
+                void *p0 = (argc >= 1) ? (void *)(uintptr_t)argv[0] : NULL;
+                if (p0)
+                {
+                    if (freed_n < (unsigned)(sizeof(freed) / sizeof(freed[0])))
+                        freed[freed_n++] = p0;
+                    else
+                    {
+                        for (unsigned k = 1; k < freed_n; ++k)
+                            freed[k - 1] = freed[k];
+                        freed[freed_n - 1] = p0;
+                    }
+                }
+            }
+            if (fn_index == 26)
+            {
+                int64_t fdv = (argc > 0) ? argv[0] : -1;
+                int64_t lenv = (argc > 2) ? argv[2] : -1;
+#if VM_ENABLE_TRACE
+                fprintf(stderr, "[VM][send] fd=%ld len=%ld ret=%ld errno=%d\n", (long)fdv, (long)lenv, (long)ret,
+                        errno);
+#endif
+            }
+                        after_call:
+#endif
+
+
+#if VM_ENABLE_TRACE
+            if (vm.debug && dbg_call_printed < 300)
+            {
+                fprintf(stderr, "[VM] RET idx=%u => %ld\n", (unsigned)fn_index, (long)ret);
+                dbg_call_printed++;
+            }
+#endif
+            // Wipe scratch area used in this call
+            if (base_scratch > vm.scratch_top)
+            {
+                memset(&vm.local_mem[vm.scratch_top], 0, base_scratch - vm.scratch_top);
+                vm.scratch_top = base_scratch;
+            }
+            if (!is_void)
+            {
+                // If return value points into local_mem, re-tag it as a local pointer
+                uintptr_t lb = (uintptr_t)&vm.local_mem[0];
+                uintptr_t ub = lb + sizeof(vm.local_mem);
+                uintptr_t rv = (uintptr_t)ret;
+                if (rv >= lb && rv < ub)
+                {
+                    size_t off = rv - lb;
+                    ret = -((int64_t)off + 1);
+                }
+                vm_push(&vm, ret);
+            }
+#if VM_ENABLE_TRACE
+            if (vm.debug)
+                printf("CALL fn[%u] argc=%u => %ld (void=%d) (SP now %d)\n", fn_index, argc, (long)ret, is_void, vm.sp);
+#endif
+            break;
+        }
+
+        case OP_RESET_SP: {
+            vm.sp = 0;
+#if VM_ENABLE_TRACE
+            if (vm.debug)
+                printf("RESET_SP (SP now %d)\n", vm.sp);
+#endif
+            break;
+        }
+
+        case OP_RET: {
+            int64_t ret_val = vm_pop(&vm);
+            
+            // Check if return value is an encrypted vm_data_table pointer and decrypt if needed
+            if (&vm_data_table && &vm_data_table_size) {
+                uintptr_t rv = (uintptr_t)ret_val;
+                for (int k = 0; k < vm_data_table_size; ++k) {
+                    if ((uintptr_t)vm_data_table[k] == rv) {
+                        // Check if this item is encrypted
+                        int is_enc = 0;
+                        if (&vm_data_is_enc)
+                            is_enc = vm_data_is_enc[k] ? 1 : 0;
+                        else if (&vm_data_len)
+                            is_enc = vm_data_len[k] > 0 ? 1 : 0;
+                        
+                        if (is_enc) {
+                            // Return decrypted stable pointer
+                            uint8_t *temp = vm_decrypt_item_cached(&vm, (uint16_t)k);
+                            
+
+                            uint8_t* stable = malloc(vm_data_len[k]);
+                            memcpy(stable,temp,vm_data_len[k]);
+                            ret_val = (int64_t)(intptr_t)stable;
+#if VM_ENABLE_TRACE
+                            if (vm.debug)
+                                fprintf(stderr, "[VM] RET decrypted global[%d] %p -> %p\n", k, (void *)rv, (void *)stable);
+#endif
+                        }
+                        break;
+                    }
+                }
+            }
+            
+#if VM_ENABLE_TRACE
+            if (vm.debug)
+                printf("RET %p\n\n", ret_val);
+#endif
+            // Zeroize sensitive VM state before returning
+            memset(vm.stack, 0, sizeof(vm.stack));
+            memset(vm.memory, 0, sizeof(vm.memory));
+            memset(vm.local_mem, 0, sizeof(vm.local_mem));
+            memset(vm.dec_idx, 0, sizeof(vm.dec_idx));
+            memset(vm.dec_off, 0, sizeof(vm.dec_off));
+            vm.dec_count = 0;
+            vm.crypto_key = 0;
+            vm.code_base_state = vm.code_cur_state = vm.code_cur_ks = 0;
+            vm.code_bpos = 0;
+            vm.code_off = 0;
+            vm.code_len = 0;
+            vm.code_encrypted = 0;
+            vm.code_ptr = NULL;
+            vm.args = NULL;
+            vm.arg_count = 0;
+            return ret_val;
+        }
+
+        case OP_HALT: {
+#if VM_ENABLE_TRACE
+            if (vm.debug)
+                printf("HALT\n");
+#endif
+            memset(vm.stack, 0, sizeof(vm.stack));
+            memset(vm.memory, 0, sizeof(vm.memory));
+            memset(vm.local_mem, 0, sizeof(vm.local_mem));
+            memset(vm.dec_idx, 0, sizeof(vm.dec_idx));
+            memset(vm.dec_off, 0, sizeof(vm.dec_off));
+            vm.dec_count = 0;
+            vm.crypto_key = 0;
+            vm.code_base_state = vm.code_cur_state = vm.code_cur_ks = 0;
+            vm.code_bpos = 0;
+            vm.code_off = 0;
+            vm.code_len = 0;
+            vm.code_encrypted = 0;
+            vm.code_ptr = NULL;
+            vm.args = NULL;
+            vm.arg_count = 0;
+            return 0;
+        }
+
+        default: {
+            fprintf(stderr, "\n[VM ERROR] Unknown opcode: 0x%02x at PC=%zu\n", opcode, vm.pc - 1);
+            exit(1);
+        }
+        }
+    }
+}
+
+// Public API: varargs wrappers with explicit arg_count as first vararg
+#include <stdarg.h>
+
+static inline int64_t vm_execute_variadic(uint8_t *bytecode, int arg_count, va_list ap)
+{
+    int64_t args_local[8];
+    int64_t *args = args_local;
+    if (arg_count > (int)(sizeof(args_local) / sizeof(args_local[0])))
+    {
+        args = (int64_t *)malloc(sizeof(int64_t) * (size_t)arg_count);
+        if (!args)
+        {
+            fprintf(stderr, "VM: out of memory allocating args\n");
+            exit(1);
+        }
+    }
+    for (int i = 0; i < arg_count; ++i)
+    {
+        // Read as intptr_t to preserve pointer/integer width
+        intptr_t v = va_arg(ap, intptr_t);
+        args[i] = (int64_t)v;
+    }
+#if VM_ENABLE_TRACE
+    fprintf(stderr,"[VM] entry bytecode=%p argc=%d\n", (void *)bytecode, arg_count);
+    for (int i = 0; i < arg_count; ++i)
+    {
+        fprintf(stderr, "  arg[%d]=%ld\n", i, (long)args[i]);
+    }
+    fflush(stderr);
+#endif
+    int64_t ret = vm_execute_internal(bytecode, args, arg_count, 0);
+    if (args != args_local)
+        free(args);
+    return ret;
+}
+
+int64_t vm_execute(uint8_t *bytecode, int arg_count, ...)
+{
+    va_list ap;
+    va_start(ap, arg_count);
+    int64_t ret = vm_execute_variadic(bytecode, arg_count, ap);
+    va_end(ap);
+    return ret;
+}
+
+int64_t vm_execute_with_args(uint8_t *bytecode, int arg_count, ...)
+{
+    va_list ap;
+    va_start(ap, arg_count);
+    int64_t ret = vm_execute_variadic(bytecode, arg_count, ap);
+    va_end(ap);
+    return ret;
+}
+
+int64_t vm_execute_with_arg(uint8_t *bytecode, int arg_count, ...)
+{
+    va_list ap;
+    va_start(ap, arg_count);
+    int64_t ret = vm_execute_variadic(bytecode, arg_count, ap);
+    va_end(ap);
+    return ret;
+}
