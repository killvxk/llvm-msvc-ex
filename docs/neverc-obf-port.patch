diff --git a/llvm/lib/Obfuscation/vm_def.h b/llvm/lib/Obfuscation/vm_def.h
new file mode 100644
index 000000000..cc0d2e368
--- /dev/null
+++ b/llvm/lib/Obfuscation/vm_def.h
@@ -0,0 +1,92 @@
+#ifndef VM_DEFS_H
+#define VM_DEFS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+// VM Opcodes - extended set for complex operations
+typedef enum
+{
+    OP_PUSH_IMM = 0x01, // Push immediate value onto stack
+    OP_STORE = 0x02,    // Store value to memory
+    OP_LOAD = 0x03,     // Load value from memory
+    OP_ADD = 0x04,      // Add two values
+    OP_RET = 0x05,      // Return from VM
+    OP_CALL = 0x06,     // Call function (reserved)
+    OP_PUSH_ARG = 0x07, // Push function argument
+    OP_SUB = 0x08,      // Subtract two values
+    OP_MUL = 0x09,      // Multiply two values
+    OP_DIV = 0x0A,      // Divide two values
+    OP_CMP_GT = 0x0B,   // Compare greater than
+    OP_CMP_LT = 0x0C,   // Compare less than
+    OP_CMP_EQ = 0x0D,   // Compare equal
+    OP_CMP_NE = 0x0E,   // Compare not equal
+    OP_BR_COND = 0x0F,  // Conditional branch (if top of stack != 0)
+    OP_JMP = 0x10,      // Unconditional jump
+    // Extended ALU and memory ops
+    OP_AND = 0x11,
+    OP_OR = 0x12,
+    OP_XOR = 0x13,
+    OP_SHL = 0x14,
+    OP_SHR = 0x15,
+    // Arithmetic right shift (sign-propagating)
+    OP_ASHR = 0x27,
+    // Unsigned comparison opcodes
+    OP_CMP_UGT = 0x28,
+    OP_CMP_ULT = 0x29,
+    OP_CMP_UGE = 0x2A,
+    OP_CMP_ULE = 0x2B,
+    // Unsigned division
+    OP_UDIV = 0x2C,
+    OP_LOAD8 = 0x16,
+    OP_STORE8 = 0x17,
+    OP_LOAD32 = 0x18,
+    OP_STORE32 = 0x19,
+    OP_LOAD64 = 0x1A,
+    OP_STORE64 = 0x1B,
+    OP_TAG_LOCAL = 0x1C,
+    OP_UREM = 0x1D,
+    OP_SREM = 0x1E,
+    OP_CMP_GE = 0x1F,
+    OP_CMP_LE = 0x20,
+    OP_PUSH_GLOB = 0x21,
+    OP_SELECT = 0x22,
+    OP_LOAD16 = 0x23,
+    OP_STORE16 = 0x24,
+    // Pointer store (64-bit) – converts tagged local to real address
+    OP_STOREPTR64 = 0x25,
+    OP_RESET_SP = 0x26,
+    OP_HALT = 0xFF // Stop VM execution
+} VMOpcode;
+
+// VM State (unified)
+typedef struct
+{
+    uint8_t *bytecode;              // Bytecode array
+    size_t pc;                      // Program counter
+    int64_t stack[256];             // Operand stack (64-bit for pointers)
+    int sp;                         // Stack pointer
+    int64_t memory[256];            // Local memory for variables
+    int64_t *args;                  // Pointer to function arguments
+    int arg_count;                  // Number of arguments
+    int debug;                      // Debug flag for tracing
+    uint64_t crypto_key;            // Active runtime key for operand encryption
+    unsigned char local_mem[65536]; // VM-local byte-addressable memory
+    size_t scratch_top;             // Cursor into local_mem for transient decrypt buffers
+    // Cache decrypted vm_data_table items per VM invocation to stabilize lifetimes
+    uint16_t dec_idx[512];
+    uint32_t dec_off[512];
+    uint16_t dec_count;
+    size_t pc_bias; // header size encoded into jump targets
+    // Encrypted bytecode fetch state (per-fetch rolling decryption)
+    uint8_t *code_ptr;        // Pointer to code payload start (after header)
+    uint32_t code_len;        // Encrypted payload length in bytes
+    int code_encrypted;       // 1 if payload is encrypted
+    uint64_t code_base_state; // base xorshift64* state for stream (derived from key+salt)
+    uint64_t code_cur_state;  // current xorshift64* state for block generation
+    uint64_t code_cur_ks;     // current 8-byte keystream cache
+    int code_bpos;            // next byte index in code_cur_ks [0..8]
+    size_t code_off;          // current offset into payload for fetch state
+} VMState;
+
+#endif // VM_DEFS_H
diff --git a/llvm/lib/Obfuscation/vmlib/vm_routine.c b/llvm/lib/Obfuscation/vmlib/vm_routine.c
new file mode 100644
index 000000000..b2422b985
--- /dev/null
+++ b/llvm/lib/Obfuscation/vmlib/vm_routine.c
@@ -0,0 +1,1877 @@
+﻿#define _CRT_SECURE_NO_WARNING
+#include "vm_def.h"
+#include <errno.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+#ifndef _WIN32
+    // Unix / Linux / macOS 平台
+    #include <alloca.h>
+    #include <pthread.h>
+    #include <sys/socket.h>
+    #include <unistd.h>
+#endif
+
+
+#ifndef VM_ENABLE_TRACE
+#define VM_ENABLE_TRACE 0
+#endif
+
+// Internal VM execution function
+// Function table provided by the instrumented module
+extern void *vm_func_table[];
+extern int vm_func_table_size;
+
+// Platform-specific attribute macros
+
+#define WEAK_SYMBOL __attribute__((weak))
+#define UNUSED_ATTR __attribute__((unused))
+
+
+// Known libc/libpq symbols for safe interception
+#ifndef _WIN32
+extern void PQclear(void *res) WEAK_SYMBOL;
+extern void free(void *ptr) WEAK_SYMBOL;
+#endif
+extern void *vm_data_table[] WEAK_SYMBOL;
+extern int vm_data_table_size WEAK_SYMBOL;
+// Optional metadata for per-item encryption in vm_data_table
+extern unsigned char vm_data_is_enc[] WEAK_SYMBOL;
+extern uint32_t vm_data_len[] WEAK_SYMBOL;
+extern uint64_t vm_data_salt[] WEAK_SYMBOL;
+extern uint64_t vm_data_key[] WEAK_SYMBOL;
+
+static inline uint64_t vm_normalize_key(uint64_t raw)
+{
+    return raw ? raw : 0x9e3779b97f4a7c15ULL;
+}
+
+static inline uint32_t vm_compute_imm_mask(uint64_t key)
+{
+    uint32_t mask = (uint32_t)((key & 0xffffffffULL) ^ (key >> 32));
+    return mask ? mask : 0xa5a5a5a5u;
+}
+
+static inline int64_t vm_encrypt_value(const VMState *vm, int64_t plain)
+{
+    return (int64_t)((uint64_t)plain ^ vm->crypto_key);
+}
+
+static inline int64_t vm_decrypt_value(const VMState *vm, int64_t cipher)
+{
+    return (int64_t)((uint64_t)cipher ^ vm->crypto_key);
+}
+
+static inline uint32_t vm_get_imm_mask(const VMState *vm)
+{
+    return vm_compute_imm_mask(vm->crypto_key);
+}
+
+static inline int32_t vm_decrypt_imm(const VMState *vm, int32_t cipher)
+{
+    return (int32_t)((uint32_t)cipher ^ vm_get_imm_mask(vm));
+}
+
+static inline void vm_push(VMState *vm, int64_t plain)
+{
+    vm->stack[vm->sp++] = vm_encrypt_value(vm, plain);
+}
+
+static inline int64_t vm_pop(VMState *vm)
+{
+    return vm_decrypt_value(vm, vm->stack[--vm->sp]);
+}
+
+static inline void vm_store_local(VMState *vm, uint8_t addr, int64_t plain)
+{
+    vm->memory[addr] = vm_encrypt_value(vm, plain);
+}
+
+static inline int64_t vm_load_local(const VMState *vm, uint8_t addr)
+{
+    return vm_decrypt_value(vm, vm->memory[addr]);
+}
+
+static inline UNUSED_ATTR int64_t vm_stack_peek_plain(const VMState *vm)
+{
+    return vm_decrypt_value(vm, vm->stack[vm->sp - 1]);
+}
+
+// xorshift64* keystream for blob encryption/decryption (simple stream)
+static inline uint64_t vm_stream_next(uint64_t *s)
+{
+    uint64_t x = *s;
+    x ^= x >> 12;
+    x ^= x << 25;
+    x ^= x >> 27;
+    *s = x;
+    return x * 2685821657736338717ULL;
+}
+
+static inline void vm_decrypt_blob_with_key(uint64_t key, const uint8_t *src, uint8_t *dst, uint32_t len, uint64_t salt)
+{
+    uint64_t st = vm_normalize_key(key) ^ salt ^ 0x9e3779b97f4a7c15ULL;
+    uint64_t ks = 0;
+    int bpos = 8; // force initial refill
+    for (uint32_t i = 0; i < len; ++i)
+    {
+        if (bpos >= 8)
+        {
+            ks = vm_stream_next(&st);
+            bpos = 0;
+        }
+        uint8_t k = (uint8_t)(ks & 0xFF);
+        ks >>= 8;
+        bpos++;
+        dst[i] = src[i] ^ k;
+    }
+}
+
+static inline void vm_decrypt_blob(const VMState *vm, const uint8_t *src, uint8_t *dst, uint32_t len, uint64_t salt)
+{
+    vm_decrypt_blob_with_key(vm->crypto_key, src, dst, len, salt);
+}
+
+static inline uint8_t *vm_decrypt_item_cached(VMState *vm, uint16_t idx)
+{
+    // Return cached decrypted pointer for vm_data_table[idx], decrypt and cache if needed
+    for (uint16_t ci = 0; ci < vm->dec_count; ++ci)
+    {
+        if (vm->dec_idx[ci] == idx)
+        {
+            return &vm->local_mem[vm->dec_off[ci]];
+        }
+    }
+    if (&vm_data_len == 0)
+        return (uint8_t *)vm_data_table[idx];
+    uint32_t L = vm_data_len[idx];
+    if (L == 0)
+        return (uint8_t *)vm_data_table[idx];
+    if (vm->scratch_top + (size_t)L + 1 > sizeof(vm->local_mem))
+    {
+        fprintf(stderr, "VM: scratch overflow in cache decrypt (%zu + %u)\n", vm->scratch_top, L);
+        exit(1);
+    }
+    uint32_t off = (uint32_t)vm->scratch_top;
+    uint8_t *dst = &vm->local_mem[off];
+    uint64_t salt = (&vm_data_salt) ? vm_data_salt[idx] : 0;
+    uint64_t key = (&vm_data_key) ? vm_data_key[idx] : vm->crypto_key;
+    vm_decrypt_blob_with_key(key, (const uint8_t *)vm_data_table[idx], dst, L, salt);
+    dst[L] = 0;
+    vm->scratch_top += (size_t)L + 1;
+    if (vm->dec_count < (sizeof vm->dec_idx / sizeof vm->dec_idx[0]))
+    {
+        vm->dec_idx[vm->dec_count] = idx;
+        vm->dec_off[vm->dec_count] = off;
+        vm->dec_count++;
+    }
+    return dst;
+}
+
+// ------- Encrypted bytecode per-fetch helpers -------
+static inline void vm_code_stream_reset(VMState *vm, size_t off)
+{
+    vm->code_cur_state = vm->code_base_state;
+    vm->code_cur_ks = 0;
+    vm->code_bpos = 8; // force initial refill
+    vm->code_off = 0;
+    // Advance to requested offset (sequentially)
+    while (vm->code_off < off)
+    {
+        if (vm->code_bpos >= 8)
+        {
+            vm->code_cur_ks = vm_stream_next(&vm->code_cur_state);
+            vm->code_bpos = 0;
+        }
+        vm->code_cur_ks >>= 8;
+        vm->code_bpos++;
+        vm->code_off++;
+    }
+}
+
+static inline uint8_t vm_fetch8(VMState *vm)
+{
+    uint8_t ct = vm->bytecode[vm->pc];
+    if (!vm->code_encrypted)
+    {
+        vm->pc++;
+        return ct;
+    }
+    if (vm->code_off != vm->pc)
+        vm_code_stream_reset(vm, vm->pc);
+    if (vm->code_bpos >= 8)
+    {
+        vm->code_cur_ks = vm_stream_next(&vm->code_cur_state);
+        vm->code_bpos = 0;
+    }
+    uint8_t k = (uint8_t)(vm->code_cur_ks & 0xFF);
+    vm->code_cur_ks >>= 8;
+    vm->code_bpos++;
+    vm->code_off++;
+    vm->pc++;
+    return (uint8_t)(ct ^ k);
+}
+
+static inline uint16_t vm_fetch16(VMState *vm)
+{
+    uint16_t lo = vm_fetch8(vm);
+    uint16_t hi = vm_fetch8(vm);
+    return (uint16_t)(lo | (uint16_t)(hi << 8));
+}
+
+static inline uint32_t vm_fetch32(VMState *vm)
+{
+    uint32_t b0 = vm_fetch8(vm);
+    uint32_t b1 = vm_fetch8(vm);
+    uint32_t b2 = vm_fetch8(vm);
+    uint32_t b3 = vm_fetch8(vm);
