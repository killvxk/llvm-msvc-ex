+/* ================== 读工具 ================== */
+static inline int rd_u8 (const uint8_t **p, const uint8_t *end, uint8_t  *out){ if(*p+1>end) return 0; *out=**p; *p+=1; return 1; }
+static inline int rd_u32(const uint8_t **p, const uint8_t *end, uint32_t *out){ if(*p+4>end) return 0; const uint8_t*s=*p; *out=(uint32_t)s[0]|((uint32_t)s[1]<<8)|((uint32_t)s[2]<<16)|((uint32_t)s[3]<<24); *p+=4; return 1; }
+static inline int rd_u64(const uint8_t **p, const uint8_t *end, uint64_t *out){ if(*p+8>end) return 0; uint64_t v=0; for(int i=0;i<8;i++) v|=(uint64_t)(*p)[i]<<(i*8); *out=v; *p+=8; return 1; }
+
+/* ================== data 段 ================== */
+typedef struct { uint8_t *buf; uint32_t sz, cap; } DataSeg;
+static void ensure_data(DataSeg* ds, uint32_t need){
+  if (need <= ds->cap){ if (need>ds->sz) ds->sz=need; return; }
+  uint32_t cap = ds->cap? ds->cap : 4096; while (cap < need) cap <<= 1;
+  ds->buf = (uint8_t*)realloc(ds->buf, cap);
+  memset(ds->buf + ds->cap, 0, cap - ds->cap);
+  ds->cap = cap; ds->sz = need;
+}
+static inline void ds_write(DataSeg* ds, uint32_t off, const void* src, uint32_t n){ ensure_data(ds, off+n); memcpy(ds->buf+off, src, n); }
+static inline void ds_read (DataSeg* ds, uint32_t off, void* dst, uint32_t n){ ensure_data(ds, off+n); memcpy(dst, ds->buf+off, n); }
+static inline uint64_t ds_load_int(DataSeg* ds, uint32_t off, uint8_t bits){
+  uint64_t u=0; uint32_t n=(bits<=8?1:bits<=16?2:bits<=32?4:8); ds_read(ds, off, &u, n);
+  if (bits<64) u &= ((1ULL<<bits)-1); return u;
+}
+static inline void ds_store_int(DataSeg* ds, uint32_t off, uint8_t bits, uint64_t u){
+  uint32_t n=(bits<=8?1:bits<=16?2:bits<=32?4:8); if (bits<64) u &= ((1ULL<<bits)-1); ds_write(ds, off, &u, n);
+}
+static inline void ds_store_u64(DataSeg* ds, uint32_t off, uint64_t u){ ds_write(ds, off, &u, 8); }
+static inline uint64_t ds_load_u64 (DataSeg* ds, uint32_t off){ uint64_t u=0; ds_read(ds, off, &u, 8); return u; }
+
+/* ========= 最近写入（last-writer）与 ALLOCA 记录 ========= */
+typedef struct { uint32_t off, sz, ip; uint8_t op; uint64_t val; } DSDef;
+static DSDef g_defs[1024];
+static unsigned g_def_head = 0;
+static inline void vmp_note_def(uint32_t off, uint32_t sz, uint32_t ip, uint8_t op, uint64_t val){
+  g_defs[g_def_head++ % (unsigned)(sizeof(g_defs)/sizeof(g_defs[0]))] = (DSDef){off, sz, ip, op, val};
+}
+static inline int vmp_find_last_def(uint32_t off, DSDef* out){
+  for (int i = 0; i < (int)(sizeof(g_defs)/sizeof(g_defs[0])); ++i){
+    DSDef d = g_defs[(g_def_head - 1 - i) & ((unsigned)sizeof(g_defs)/sizeof(g_defs[0]) - 1)];
+    if (d.sz != 0 && d.off == off){ *out = d; return 1; }
+  }
+  return 0;
+}
+static inline uint32_t vmp_nbytes_by_bits(uint8_t bits){
+  return (bits<=8?1:bits<=16?2:bits<=32?4:8);
+}
+
+/* 记录栈上分配的内存范围，便于地址分类 */
+typedef struct { uint64_t p; uint32_t sz; uint32_t ip; } AllocRec;
+static AllocRec g_allocs[256]; static unsigned g_alloc_n=0;
+
+static inline const char* vmp_addr_class(uint64_t a){
+  if (!a) return "NULL";
+  if (a < (uint64_t)VMP_ADDR_GUARD_THRESHOLD) return "low";
+  for (unsigned i=0;i<g_alloc_n;i++){
+    uint64_t lo=g_allocs[i].p, hi=lo+g_allocs[i].sz;
+    if (a>=lo && a<hi) return "alloca";
+  }
+  return "unknown";
+}
+
+/* ================== value 解码 ================== */
+typedef struct {
+  uint8_t is_slot, ck; uint32_t size;
+  union { uint64_t u; float f32; double f64; } v;
+  uint32_t slot_off;
+} EncVal;
+
+static int read_value(const uint8_t **p, const uint8_t *end, EncVal* out){
+  uint8_t tag; if (!rd_u8(p,end,&tag)) return 0; memset(out,0,sizeof(*out));
+  if (tag==VT_CONST){
+    uint8_t ck; uint32_t sz; if (!rd_u8(p,end,&ck) || !rd_u32(p,end,&sz)) return 0;
+    out->is_slot=0; out->ck=ck; out->size=sz;
+    if (ck==CK_INT || ck==CK_PTR) return rd_u64(p,end,&out->v.u);
+    if (ck==CK_F64){ uint64_t bits; if(!rd_u64(p,end,&bits)) return 0; memcpy(&out->v.f64,&bits,8); return 1; }
+    if (ck==CK_F32){ uint32_t bits; if(!rd_u32(p,end,&bits)) return 0; memcpy(&out->v.f32,&bits,4); return 1; }
+    return 0;
+  } else if (tag==VT_SLOT){
+    uint32_t off; if (!rd_u32(p,end,&off)) return 0; out->is_slot=1; out->slot_off=off; return 1;
+  }
+  return 0;
+}
+
+/* ================== 辅助转换 ================== */
+static inline int64_t sextN(uint64_t u, uint8_t bits){
+  switch(bits){ case 8: return (int8_t)u; case 16: return (int16_t)u; case 32: return (int32_t)u; default: return (int64_t)u; }
+}
+static inline uint64_t get_as_u64(DataSeg* ds, const EncVal* e, uint8_t bits, uint8_t tk){
+  if (!e->is_slot){
+    if (e->ck==CK_INT||e->ck==CK_PTR) return e->v.u;
+    if (e->ck==CK_F32){ uint32_t b; memcpy(&b, &e->v.f32, 4); return (uint64_t)b; }
+    if (e->ck==CK_F64){ uint64_t b; memcpy(&b, &e->v.f64, 8); return b; }
+    return 0;
+  } else {
+    if (tk==TK_INT) return ds_load_int(ds, e->slot_off, bits);
+    return ds_load_u64(ds, e->slot_off);
+  }
+}
+static inline double get_as_f64(DataSeg* ds, const EncVal* e){
+  if (!e->is_slot){
+    if (e->ck==CK_F64) return e->v.f64;
+    if (e->ck==CK_F32) return (double)e->v.f32;
+    if (e->ck==CK_INT||e->ck==CK_PTR) return (double)e->v.u;
+    return 0.0;
+  } else { uint64_t bits=ds_load_u64(ds,e->slot_off); double d; memcpy(&d,&bits,8); return d; }
+}
+static inline float get_as_f32(DataSeg* ds, const EncVal* e){
+  if (!e->is_slot){
+    if (e->ck==CK_F32) return e->v.f32;
+    if (e->ck==CK_F64) return (float)e->v.f64;
+    if (e->ck==CK_INT||e->ck==CK_PTR) return (float)e->v.u;
+    return 0.f;
+  } else { uint32_t bits=0; ds_read(ds,e->slot_off,&bits,4); float f; memcpy(&f,&bits,4); return f; }
+}
+
+/* ====== FCmp 实现（与 LLVM 谓词一致） ====== */
+static inline uint64_t vmp_fcmp(uint8_t pred, double L, double R){
+  int lnan = (L!=L), rnan = (R!=R);
+  int uno = lnan || rnan;
+  switch(pred){
+    case FCMP_FALSE: return 0;
+    case FCMP_OEQ:   return (!uno) && (L==R);
+    case FCMP_OGT:   return (!uno) && (L> R);
+    case FCMP_OGE:   return (!uno) && (L>=R);
+    case FCMP_OLT:   return (!uno) && (L< R);
+    case FCMP_OLE:   return (!uno) && (L<=R);
+    case FCMP_ONE:   return (!uno) && (L!=R);
+    case FCMP_ORD:   return (!uno);
+    case FCMP_UNO:   return (uno);
+    case FCMP_UEQ:   return (uno) || (L==R);
+    case FCMP_UGT:   return (uno) || (L> R);
+    case FCMP_UGE:   return (uno) || (L>=R);
+    case FCMP_ULT:   return (uno) || (L< R);
+    case FCMP_ULE:   return (uno) || (L<=R);
+    case FCMP_UNE:   return (uno) || (L!=R);
+    case FCMP_TRUE:  return 1;
+    default: return 0;
+  }
+}
