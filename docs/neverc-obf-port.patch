+/* ============ Trace 全局（仅在本 TU 可见） ============ */
+static int      vmp_trace_inited  = 0;
+static unsigned vmp_trace_mask    = VMP_TRACE_DEFAULT_MASK;
+static int      vmp_trace_enabled = 0;
+
+static inline int vmp_str_ieq(const char *a, const char *b) {
+  while (*a && *b) {
+    char ca = *a, cb = *b;
+    if (ca >= 'A' && ca <= 'Z') ca += 'a' - 'A';
+    if (cb >= 'A' && cb <= 'Z') cb += 'a' - 'A';
+    if (ca != cb) return 0;
+    ++a; ++b;
+  }
+  return *a == 0 && *b == 0;
+}
+
+static inline void vmp_trace_init_from_env(void) {
+#if VMP_TRACE_COMPILED
+  if (vmp_trace_inited) return;
+  vmp_trace_inited = 1;
+  const char *env = getenv("VMP_TRACE");
+  if (!env) return;
+  if (env[0] == '0' && env[1] == '\0') { vmp_trace_enabled = 0; return; }
+  vmp_trace_enabled = 1;
+  if (env[0] == '1' && env[1] == '\0') return;
+
+  unsigned m = 0;
+  const char *p = env;
+  while (*p) {
+    while (*p == ',' || *p == ' ' || *p == '\t') ++p;
+    const char *start = p;
+    while (*p && *p != ',' && *p != ' ' && *p != '\t') ++p;
+    size_t len = (size_t)(p - start);
+    if (len) {
+      char buf[32]; if (len >= sizeof(buf)) len = sizeof(buf)-1;
+      memcpy(buf, start, len); buf[len] = '\0';
+      if (vmp_str_ieq(buf, "op"))   m |= VMP_T_OP;
+      else if (vmp_str_ieq(buf, "mem"))  m |= VMP_T_MEM;
+      else if (vmp_str_ieq(buf, "call")) m |= VMP_T_CALL;
+      else if (vmp_str_ieq(buf, "flow")) m |= VMP_T_FLOW;
+      else if (vmp_str_ieq(buf, "data")) m |= VMP_T_DATA;
+      else if ((buf[0] >= '0' && buf[0] <= '9') || buf[0]=='x') {
+        m |= (unsigned)strtoul(buf, NULL, 0);
+      }
+    }
+  }
+  if (m) vmp_trace_mask = m;
+#else
+  (void)env;
+#endif
+}
+
+static inline void vmp_set_trace(int on) {
+#if VMP_TRACE_COMPILED
+  vmp_trace_enabled = !!on;
+  vmp_trace_inited = 1;
+#else
+  (void)on;
+#endif
+}
+static inline void vmp_set_trace_mask(unsigned mask) {
+#if VMP_TRACE_COMPILED
+  vmp_trace_mask = mask; vmp_trace_inited = 1;
+#else
+  (void)mask;
+#endif
+}
+static inline int vmp_should_trace(unsigned cat) {
+#if VMP_TRACE_COMPILED
+  return vmp_trace_enabled && (vmp_trace_mask & cat);
+#else
+  (void)cat; return 0;
+#endif
+}
+#define VMP_TRACE(cat, fmt, ...) \
+  do { if (vmp_should_trace((cat))) fprintf(stderr, fmt, ##__VA_ARGS__); } while (0)
