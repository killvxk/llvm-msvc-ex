+  switch(sub){
+    case 0:  return "ADD"; case 1:  return "SUB"; case 2:  return "MUL";
+    case 3:  return "UDIV";case 4:  return "SDIV";case 5:  return "UREM";
+    case 6:  return "SREM";case 7:  return "SHL"; case 8:  return "LSHR";
+    case 9:  return "ASHR";case 10: return "AND"; case 11: return "OR";
+    case 12: return "XOR"; case 13: return "FADD";case 14: return "FSUB";
+    case 15: return "FMUL";case 16: return "FDIV";case 17: return "FREM";
