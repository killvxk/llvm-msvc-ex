+/* ================== 主执行 ================== */
+uint64_t vm_exec(const uint8_t* code, uint32_t code_size, void** vm_args, uint64_t vm_num)
+{
+  vmp_trace_init_from_env();
+
+  const uint8_t *p = code, *end = code+code_size;
+  DataSeg ds = (DataSeg){0,0,0}; uint64_t ret_u64 = 0;
+
+  while (p < end){
+    size_t ip = (size_t)(p - code);
+    uint8_t op; if (!rd_u8(&p,end,&op)) break;
+
+    VMP_TRACE(VMP_T_OP, "[vm] ip=0x%zx op=%s(0x%02X)\n", ip, vmp_op_name(op), op);
+
+    switch(op){
+
+      case OP_PARAMMAP:{
+        uint32_t n; if (!rd_u32(&p,end,&n)) goto trunc;
+        VMP_TRACE(VMP_T_DATA, "        PARAMMAP count=%u (vm_num=%" PRIu64 ")\n", n, vm_num);
+        for (uint32_t i=0;i<n;i++){
+          uint32_t off, sz; if (!rd_u32(&p,end,&off) || !rd_u32(&p,end,&sz)) goto trunc;
+          ensure_data(&ds, off+sz);
+          if (i < vm_num && vm_args && vm_args[i]) {
+            memcpy(ds.buf+off, vm_args[i], sz);
+            vmp_note_def(off, sz, (uint32_t)ip, OP_PARAMMAP, 0);
+            VMP_TRACE(VMP_T_DATA, "          arg[%u] -> ds[%u..%u) from %p, sz=%u\n",
+                     i, off, off+sz, vm_args[i], sz);
+          } else {
+            memset(ds.buf+off, 0, sz);
+            vmp_note_def(off, sz, (uint32_t)ip, OP_PARAMMAP, 0);
+            VMP_TRACE(VMP_T_DATA, "          arg[%u] -> ds[%u..%u) ZERO, sz=%u\n",
+                     i, off, off+sz, sz);
+          }
+        }
+      } break;
+
+      case OP_ALLOCA:{
+        uint32_t dst, area; if (!rd_u32(&p,end,&dst) || !rd_u32(&p,end,&area)) goto trunc;
+        void *mem = area ? malloc(area) : NULL;
+        ds_store_u64(&ds, dst, (uint64_t)(uintptr_t)mem);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_ALLOCA, (uint64_t)(uintptr_t)mem);
+        if (mem && area && g_alloc_n < (sizeof(g_allocs)/sizeof(g_allocs[0])))
+          g_allocs[g_alloc_n++] = (AllocRec){ (uint64_t)(uintptr_t)mem, area, (uint32_t)ip };
+        VMP_TRACE(VMP_T_MEM, "        ALLOCA area=%u -> ds[%u]=%p\n", area, dst, mem);
+      } break;
+
+      case OP_LOAD:{
+        uint32_t dst; if (!rd_u32(&p,end,&dst)) goto trunc;
+        EncVal ptrv; if (!read_value(&p,end,&ptrv)) goto trunc;
+        uint64_t addr = ptrv.is_slot ? ds_load_u64(&ds, ptrv.slot_off)
+                                     : (ptrv.ck==CK_PTR||ptrv.ck==CK_INT ? ptrv.v.u : 0);
+
+        if (ptrv.is_slot){
+          DSDef d;
+          if (vmp_find_last_def(ptrv.slot_off, &d))
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last ip=0x%x op=%s val=0x%016" PRIx64 "\n",
+                      ptrv.slot_off, d.ip, vmp_op_name(d.op), d.val);
+          else
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last=? (no def)\n", ptrv.slot_off);
+        }
+        VMP_TRACE(VMP_T_MEM, "          base %p class=%s\n",
+                  (void*)(uintptr_t)addr, vmp_addr_class(addr));
+
+#if VMP_ADDR_GUARD_LOW
+        if (addr < (uint64_t)VMP_ADDR_GUARD_THRESHOLD){
+          VMP_TRACE(VMP_T_MEM, "        LOAD  GUARD: addr=%p too low, skip & trunc\n", (void*)(uintptr_t)addr);
+          goto trunc;
+        }
+#endif
+        /* 兼容旧编码：按 8 字节读；后续若有带宽版本，再扩展新 opcode */
+        uint64_t val = 0; memcpy(&val, (void*)(uintptr_t)addr, 8);
+        ds_store_u64(&ds, dst, val);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_LOAD, val);
+        VMP_TRACE(VMP_T_MEM, "        LOAD  from %p -> ds[%u]=0x%016" PRIx64 "\n",
+                  (void*)(uintptr_t)addr, dst, val);
+      } break;
+
+      case OP_STORE:{
+        EncVal val, ptrv; if (!read_value(&p,end,&val) || !read_value(&p,end,&ptrv)) goto trunc;
+        uint64_t addr = ptrv.is_slot ? ds_load_u64(&ds, ptrv.slot_off)
+                                     : (ptrv.ck==CK_PTR||ptrv.ck==CK_INT ? ptrv.v.u : 0);
+
+        if (ptrv.is_slot){
+          DSDef d;
+          if (vmp_find_last_def(ptrv.slot_off, &d))
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last ip=0x%x op=%s val=0x%016" PRIx64 "\n",
+                      ptrv.slot_off, d.ip, vmp_op_name(d.op), d.val);
+          else
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last=? (no def)\n", ptrv.slot_off);
+        }
+        VMP_TRACE(VMP_T_MEM, "          base %p class=%s\n",
+                  (void*)(uintptr_t)addr, vmp_addr_class(addr));
+
+#if VMP_ADDR_GUARD_LOW
+        if (addr < (uint64_t)VMP_ADDR_GUARD_THRESHOLD){
+          VMP_TRACE(VMP_T_MEM, "        STORE GUARD: addr=%p too low, skip & trunc\n", (void*)(uintptr_t)addr);
+          goto trunc;
+        }
+#endif
+        uint64_t u = 0;
+        if (!val.is_slot){
+          if (val.ck==CK_F32){ uint32_t bits; memcpy(&bits,&val.v.f32,4); memcpy((void*)(uintptr_t)addr,&bits,4); u = bits; }
+          else if (val.ck==CK_F64){ uint64_t bits; memcpy(&bits,&val.v.f64,8); memcpy((void*)(uintptr_t)addr,&bits,8); u = bits; }
+          else { memcpy((void*)(uintptr_t)addr,&val.v.u,8); u = val.v.u; }
+        } else {
+          u = ds_load_u64(&ds, val.slot_off);
+          memcpy((void*)(uintptr_t)addr,&u,8);
+        }
+        VMP_TRACE(VMP_T_MEM, "        STORE 0x%016" PRIx64 " -> %p\n", u, (void*)(uintptr_t)addr);
+      } break;
+
+      case OP_GEP:{ /* 旧版：把所有 index 当“字节偏移”直接累加 */
+        uint32_t dst; if (!rd_u32(&p,end,&dst)) goto trunc;
+        EncVal base; if (!read_value(&p,end,&base)) goto trunc;
+        uint32_t nidx; if (!rd_u32(&p,end,&nidx)) goto trunc;
+        uint64_t base_ptr = base.is_slot ? ds_load_u64(&ds, base.slot_off)
+                                         : (base.ck==CK_PTR||base.ck==CK_INT ? base.v.u : 0);
+
+        if (base.is_slot){
+          DSDef d;
+          if (vmp_find_last_def(base.slot_off, &d))
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last ip=0x%x op=%s val=0x%016" PRIx64 "\n",
+                      base.slot_off, d.ip, vmp_op_name(d.op), d.val);
+          else
+            VMP_TRACE(VMP_T_MEM, "          base slot=%u last=? (no def)\n", base.slot_off);
+        }
+        VMP_TRACE(VMP_T_MEM, "          base %p class=%s\n",
+                  (void*)(uintptr_t)base_ptr, vmp_addr_class(base_ptr));
+
+        int64_t off = 0;
+        for (uint32_t i=0;i<nidx;i++){
+          EncVal idx; if(!read_value(&p,end,&idx)) goto trunc;
+          uint64_t add = idx.is_slot ? ds_load_u64(&ds, idx.slot_off) : idx.v.u;
+          off += (int64_t)add;
+          VMP_TRACE(VMP_T_OP, "          idx[%u]=%s%u add=%" PRId64 "\n",
+                    i, idx.is_slot?"slot:":"const:", idx.is_slot?idx.slot_off:0u, (int64_t)add);
+        }
+        uint64_t res = base_ptr + (uint64_t)off;
+        ds_store_u64(&ds, dst, res);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_GEP, res);
+        VMP_TRACE(VMP_T_OP, "        GEP   base=%p,+%lld -> ds[%u]=%p\n",
+                  (void*)(uintptr_t)base_ptr, (long long)off, dst, (void*)(uintptr_t)res);
+      } break;
+
+      /* ===== 新增：GEP_SCALED（将来转换器会发，带每个 index 的缩放系数） ===== */
+      case OP_GEP_SCALED:{
+        uint32_t dst; if (!rd_u32(&p,end,&dst)) goto trunc;
+        EncVal base; if (!read_value(&p,end,&base)) goto trunc;
+        uint32_t k; if (!rd_u32(&p,end,&k)) goto trunc;
+        uint64_t base_ptr = base.is_slot ? ds_load_u64(&ds, base.slot_off)
+                                         : (base.ck==CK_PTR||base.ck==CK_INT ? base.v.u : 0);
+        int64_t off = 0;
+        for (uint32_t i=0;i<k;i++){
+          EncVal idx; if(!read_value(&p,end,&idx)) goto trunc;
+          uint64_t scale; if(!rd_u64(&p,end,&scale)) goto trunc;
+          int64_t iv = (int64_t)( idx.is_slot ? ds_load_u64(&ds, idx.slot_off) :
+                                               (idx.ck==CK_INT||idx.ck==CK_PTR?idx.v.u:(uint64_t)0) );
+          off += iv * (int64_t)scale;
+          VMP_TRACE(VMP_T_OP, "          term[%u]: idx=%lld scale=%" PRIu64 " add=%lld\n",
+                    i, (long long)iv, (unsigned long long)scale, (long long)(iv*(int64_t)scale));
+        }
+        uint64_t res = base_ptr + (uint64_t)off;
+        ds_store_u64(&ds, dst, res);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_GEP_SCALED, res);
+        VMP_TRACE(VMP_T_OP, "        GEP2  base=%p,+%lld -> ds[%u]=%p\n",
+                  (void*)(uintptr_t)base_ptr, (long long)off, dst, (void*)(uintptr_t)res);
+      } break;
+
+      case OP_CMP:{
+        uint8_t pred; uint32_t dst; if (!rd_u8(&p,end,&pred) || !rd_u32(&p,end,&dst)) goto trunc;
+        EncVal L,R; if (!read_value(&p,end,&L) || !read_value(&p,end,&R)) goto trunc;
+
+        uint64_t res=0;
+        if (pred < 32){ /* ===== 新增：FCmp 路径 ===== */
+          double dl = get_as_f64(&ds,&L), dr = get_as_f64(&ds,&R);
+          res = vmp_fcmp(pred, dl, dr);
+          VMP_TRACE(VMP_T_OP, "        FCMP  pred=%u, L=%g, R=%g -> %u\n",
+                    pred, dl, dr, (unsigned)res);
+        } else {        /* ===== 旧：ICmp 路径 ===== */
+          uint64_t ul = L.is_slot ? ds_load_u64(&ds,L.slot_off) : (L.ck==CK_PTR||L.ck==CK_INT?L.v.u:(uint64_t)L.v.f64);
+          uint64_t ur = R.is_slot ? ds_load_u64(&ds,R.slot_off) : (R.ck==CK_PTR||R.ck==CK_INT?R.v.u:(uint64_t)R.v.f64);
+          int64_t  sl = (int64_t)ul, sr = (int64_t)ur;
+          switch(pred){
+            case ICMP_EQ: res = (ul==ur); break; case ICMP_NE: res = (ul!=ur); break;
+            case ICMP_UGT:res = (ul> ur); break; case ICMP_UGE: res = (ul>=ur); break;
+            case ICMP_ULT:res = (ul< ur); break; case ICMP_ULE:res = (ul<=ur); break;
+            case ICMP_SGT:res = (sl> sr); break; case ICMP_SGE:res = (sl>=sr); break;
+            case ICMP_SLT:res = (sl< sr); break; case ICMP_SLE:res = (sl<=sr); break;
+            default: res = 0; break;
+          }
+          VMP_TRACE(VMP_T_OP, "        ICMP  pred=%u, L=0x%016" PRIx64 ", R=0x%016" PRIx64 " -> %u\n",
+                    pred, ul, ur, (unsigned)res);
+        }
+        ds_store_u64(&ds, dst, res);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_CMP, res);
+      } break;
+
+      case OP_CAST:{
+        uint8_t cop; uint32_t dst; if (!rd_u8(&p,end,&cop) || !rd_u32(&p,end,&dst)) goto trunc;
+        EncVal V; if (!read_value(&p,end,&V)) goto trunc;
+        uint64_t u = V.is_slot ? ds_load_u64(&ds, V.slot_off)
+                               : (V.ck==CK_INT||V.ck==CK_PTR?V.v.u:(V.ck==CK_F32? (uint64_t)(*(uint32_t*)&V.v.f32)
+                                                                                : (*(uint64_t*)&V.v.f64)));
+        uint64_t w=0;
+        switch(cop){
+          case Cast_ZExt: case Cast_PtrToInt: case Cast_IntToPtr: case Cast_BitCast: w=u; break;
+          case Cast_SExt:  w=(uint64_t)(int64_t)(int32_t)u; break;
+          case Cast_Trunc: w=(uint64_t)(uint32_t)u; break;
+          case Cast_UIToFP:{ double d=(double)u; memcpy(&w,&d,8); } break;
+          case Cast_SIToFP:{ double d=(double)(int64_t)u; memcpy(&w,&d,8); } break;
+          case Cast_FPToUI:{
+            double d;
+            if (V.is_slot) memcpy(&d, &u, 8);
+            else d = (V.ck==CK_F64? V.v.f64 : (double)V.v.f32);
+            w=(uint64_t)d;
+          } break;
+          case Cast_FPToSI:{
+            double d;
+            if (V.is_slot) memcpy(&d, &u, 8);
+            else d = (V.ck==CK_F64? V.v.f64 : (double)V.v.f32);
+            w=(uint64_t)(int64_t)d;
+          } break;
+          default: w=u; break;
+        }
+        ds_store_u64(&ds, dst, w);
+        vmp_note_def(dst, 8, (uint32_t)ip, OP_CAST, w);
+        VMP_TRACE(VMP_T_OP, "        CAST  %s 0x%016" PRIx64 " -> ds[%u]=0x%016" PRIx64 "\n",
+                  vmp_cast_name(cop), u, dst, w);
+      } break;
+
+      case OP_BR:{
+        uint8_t isCond; if (!rd_u8(&p,end,&isCond)) goto trunc;
+        if (!isCond){
+          uint32_t trg; if(!rd_u32(&p,end,&trg)) goto trunc; if (trg>=code_size) goto trunc;
+          VMP_TRACE(VMP_T_FLOW, "        BR    -> 0x%08x (abs ip)\n", trg);
+          p=code+trg;
+        } else {
+          EncVal C; if(!read_value(&p,end,&C)) goto trunc;
+          uint32_t T,F; if(!rd_u32(&p,end,&T)||!rd_u32(&p,end,&F)) goto trunc;
+          uint64_t cond = C.is_slot? ds_load_u64(&ds, C.slot_off) : (C.ck==CK_INT||C.ck==CK_PTR?C.v.u:(uint64_t)C.v.f64);
+          uint32_t trg = cond?T:F; if (trg>=code_size) goto trunc;
+          VMP_TRACE(VMP_T_FLOW, "        BRc   cond=%" PRIu64 " ? 0x%08x : 0x%08x -> 0x%08x\n",
+                    (unsigned long long)cond, T, F, trg);
+          p=code+trg;
+        }
+      } break;
+
+      case OP_ARITH:{
+        uint8_t sub, tk, bits; uint32_t dst;
+        if (!rd_u8(&p,end,&sub)||!rd_u8(&p,end,&tk)||!rd_u8(&p,end,&bits)||!rd_u32(&p,end,&dst)) goto trunc;
+        EncVal L,R; if(!read_value(&p,end,&L)||!read_value(&p,end,&R)) goto trunc;
+        if (tk==TK_INT){
+          uint64_t ul=get_as_u64(&ds,&L,bits,TK_INT), ur=get_as_u64(&ds,&R,bits,TK_INT), res=0;
+          switch(sub){
+            case AR_ADD:res=ul+ur;break; case AR_SUB:res=ul-ur;break; case AR_MUL:res=ul*ur;break;
+            case AR_UDIV:res=(ur?ul/ur:0);break; case AR_UREM:res=(ur?ul%ur:0);break;
+            case AR_SDIV:res=(ur?(uint64_t)(sextN(ul,bits)/sextN(ur,bits)):0);break;
+            case AR_SREM:res=(ur?(uint64_t)(sextN(ul,bits)%sextN(ur,bits)):0);break;
+            case AR_SHL:res=ul<<(ur&63);break; case AR_LSHR:res=ul>>(ur&63);break;
+            case AR_ASHR:res=(uint64_t)(sextN(ul,bits)>>(ur&63));break;
+            case AR_AND:res=ul&ur;break; case AR_OR:res=ul|ur;break; case AR_XOR:res=ul^ur;break;
+          }
+          ds_store_int(&ds, dst, bits, res);
+          vmp_note_def(dst, vmp_nbytes_by_bits(bits), (uint32_t)ip, OP_ARITH, res);
+          VMP_TRACE(VMP_T_OP, "        ARITH %-4s tk=I bits=%u  L=0x%016" PRIx64 " R=0x%016" PRIx64 " -> ds[%u]=0x%016" PRIx64 "\n",
+                    vmp_arith_name(sub), bits, ul, ur, dst, res);
+        } else {
+          if (bits==32){
+            float fl=get_as_f32(&ds,&L), fr=get_as_f32(&ds,&R), f=0.f;
+            switch(sub){ case AR_FADD:f=fl+fr;break; case AR_FSUB:f=fl-fr;break; case AR_FMUL:f=fl*fr;break;
+                         case AR_FDIV:f=fl/fr;break; case AR_FREM:f=vm_fmodf(fl,fr);break; }
+            ds_write(&ds,dst,&f,4);
+            { uint32_t vb; memcpy(&vb,&f,4); vmp_note_def(dst,4,(uint32_t)ip,OP_ARITH,(uint64_t)vb); }
+            VMP_TRACE(VMP_T_OP, "        ARITH %-4s tk=F32 L=%g R=%g -> ds[%u]=%g\n",
+                      vmp_arith_name(sub), (double)fl, (double)fr, dst, (double)f);
+          } else {
+            double dl=get_as_f64(&ds,&L), dr=get_as_f64(&ds,&R), d=0.0;
+            switch(sub){ case AR_FADD:d=dl+dr;break; case AR_FSUB:d=dl-dr;break; case AR_FMUL:d=dl*dr;break;
+                         case AR_FDIV:d=dl/dr;break; case AR_FREM:d=vm_fmod(dl,dr);break; }
+            ds_write(&ds,dst,&d,8);
+            { uint64_t vb; memcpy(&vb,&d,8); vmp_note_def(dst,8,(uint32_t)ip,OP_ARITH,vb); }
+            VMP_TRACE(VMP_T_OP, "        ARITH %-4s tk=F64 L=%g R=%g -> ds[%u]=%g\n",
+                      vmp_arith_name(sub), dl, dr, dst, d);
+          }
+        }
+      } break;
+
+      /* ===== 新增：SELECT（将来转换器会发：tk,bits,dst,cond,trueV,falseV） ===== */
+      case OP_SELECT:{
+        uint8_t tk, bits; uint32_t dst;
+        if(!rd_u8(&p,end,&tk)||!rd_u8(&p,end,&bits)||!rd_u32(&p,end,&dst)) goto trunc;
+        EncVal C,T,F; if(!read_value(&p,end,&C)||!read_value(&p,end,&T)||!read_value(&p,end,&F)) goto trunc;
+        uint64_t cond = C.is_slot? ds_load_u64(&ds, C.slot_off) :
+                                   (C.ck==CK_INT||C.ck==CK_PTR?C.v.u:(uint64_t)C.v.f64);
+        if (tk==TK_INT){
+          uint64_t u = cond ? get_as_u64(&ds,&T,bits,TK_INT) : get_as_u64(&ds,&F,bits,TK_INT);
+          ds_store_int(&ds, dst, bits, u);
+          vmp_note_def(dst, vmp_nbytes_by_bits(bits), (uint32_t)ip, OP_SELECT, u);
+          VMP_TRACE(VMP_T_OP, "        SELECT I%u cond=%" PRIu64 " -> 0x%016" PRIx64 "\n",
+                    bits, (unsigned long long)cond, (unsigned long long)u);
+        } else {
+          if (bits==32){
+            float tv=get_as_f32(&ds,&T), fv=get_as_f32(&ds,&F), r = cond?tv:fv;
+            ds_write(&ds, dst, &r, 4);
+            { uint32_t vb; memcpy(&vb,&r,4); vmp_note_def(dst,4,(uint32_t)ip,OP_SELECT,(uint64_t)vb); }
+            VMP_TRACE(VMP_T_OP, "        SELECT F32 cond=%" PRIu64 " -> %g\n",
+                      (unsigned long long)cond, (double)r);
+          } else {
+            double tv=get_as_f64(&ds,&T), fv=get_as_f64(&ds,&F), r = cond?tv:fv;
+            ds_write(&ds, dst, &r, 8);
+            { uint64_t vb; memcpy(&vb,&r,8); vmp_note_def(dst,8,(uint32_t)ip,OP_SELECT,vb); }
+            VMP_TRACE(VMP_T_OP, "        SELECT F64 cond=%" PRIu64 " -> %g\n",
+                      (unsigned long long)cond, r);
+          }
+        }
+      } break;
+
+      case OP_CALL:{
+        uint64_t id; uint32_t dst; if(!rd_u64(&p,end,&id)||!rd_u32(&p,end,&dst)) goto trunc;
+        uint32_t dynN; if (!rd_u32(&p,end,&dynN)) goto trunc;
+        void **a2 = dynN? (void**)malloc(sizeof(void*)*dynN) : NULL;
+        for (uint32_t i=0;i<dynN;i++){
+          uint32_t off; if(!rd_u32(&p,end,&off)){ free(a2); goto trunc; }
+          ensure_data(&ds, off+1);
+          a2[i] = (void*)(ds.buf + off);
+          VMP_TRACE(VMP_T_CALL, "        CALL  id=%" PRIu64 " arg[%u]=ds+%u -> %p\n",
+                    (unsigned long long)id, i, off, a2[i]);
+        }
+        VMP_TRACE(VMP_T_CALL, "        CALL  id=%" PRIu64 " dynN=%u dst=%s\n",
+                  (unsigned long long)id, dynN, (dst!=0xFFFFFFFFu)?"slot":"void");
+
+        uint64_t r =
+#if HANDLE_CALL_WITH_NUM
+          handle_call(id, a2, (uint64_t)dynN);
+#else
+          handle_call(id, a2);
+#endif
+        if (a2) free(a2);
+        if (dst != 0xFFFFFFFFu) { ds_store_u64(&ds, dst, r); vmp_note_def(dst,8,(uint32_t)ip,OP_CALL,r); }
+        VMP_TRACE(VMP_T_CALL, "        CALL  ret=0x%016" PRIx64 "%s\n",
+                  r, (dst!=0xFFFFFFFFu)?" (stored)":"");
+      } break;
+
+      case OP_RET:{
+        EncVal V; if (!read_value(&p,end,&V)) goto trunc;
+        if (!V.is_slot){
+          if (V.ck==CK_INT || V.ck==CK_PTR) ret_u64 = V.v.u;
+          else if (V.ck==CK_F32){ uint32_t b; memcpy(&b,&V.v.f32,4); ret_u64 = (uint64_t)b; }
+          else if (V.ck==CK_F64){ uint64_t b; memcpy(&b,&V.v.f64,8); ret_u64 = b; }
+        } else ret_u64 = ds_load_u64(&ds, V.slot_off);
+        VMP_TRACE(VMP_T_FLOW, "        RET   0x%016" PRIx64 "\n", ret_u64);
+        free(ds.buf); return ret_u64;
+      } break;
+
+      default:
+        fprintf(stderr,"[vm] unknown opcode 0x%02X at %zu\n", op, ip);
+        goto trunc;
+    }
+  }
+
+trunc:
+  free(ds.buf); return ret_u64;
+}
+
+#endif /* MYPASS_VMP_H */
diff --git a/llvm/lib/Obfuscation/VariableRotation.cpp b/llvm/lib/Obfuscation/VariableRotation.cpp
new file mode 100644
index 000000000..ac70b2523
--- /dev/null
+++ b/llvm/lib/Obfuscation/VariableRotation.cpp
@@ -0,0 +1,286 @@
+﻿#include "VariableRotation.h"
+#include "BogusControlFlow.h"
+#include "ConstObfuscation.h"
+#include "CryptoUtils.h"
+#include "Flattening.h"
+#include "IndirectGlobalVars.h"
+#include "Utils.h"
+#include "VMFlatten.h"
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/SetVector.h"
+#include "llvm/IR/BasicBlock.h"
+#include "llvm/IR/Constant.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/GlobalValue.h"
+#include "llvm/IR/GlobalVariable.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Type.h"
+#include "llvm/IR/Verifier.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Transforms/Utils/Local.h"
+#include "llvm/Transforms/Utils/LowerSwitch.h"
+#include "llvm/Transforms/Utils/ValueMapper.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iomanip>
+#include <map>
+#include <set>
+#include <sstream>
+#ifdef _MSC_VER
+#include <vcruntime_string.h>
+#endif
+#include <vector>
+
+using namespace llvm;
+static cl::opt<bool> RunVarRot("x-var-rot", cl::init(false),
+                               cl::desc("OLLVM - variable rotation"));
+
+namespace {
+struct VariableRotation {
+  Function *createRotateFunc(Module *m, PointerType *ptrType, Twine &name);
+  void processFunction(Function &f, const SetVector<Function *> &shift);
+  bool processVars(Function &f, SetVector<AllocaInst *> &vars,
+                   Function *rotateFunc);
+  bool isUsedByInst(Instruction *inst, const Value *var);
+  bool runOnModule(Module &m);
+};
+
+Function *VariableRotation::createRotateFunc(Module *m, PointerType *ptrType,
+                                             Twine &name) {
+
+  IRBuilder<> builder(m->getContext());
+
+  // Function argument types
+  std::vector<Type *> funcArgs(
+      {ptrType,
+                                builder.getInt32Ty(), builder.getInt32Ty()});
+
+  // Create the function type and function
+  FunctionType *funcType =
+      FunctionType::get(Type::getVoidTy(m->getContext()), funcArgs, false);
+  Function *theFunction =
+      Function::Create(funcType, Function::PrivateLinkage,
+                                           name, m);
+
+  // Define the function arguments
+  Function::arg_iterator args = theFunction->arg_begin();
+  Value *a1 = args++;
+  a1->setName("a1");
+  Value *a2 = args++;
+  a2->setName("a2");
+  Value *a3 = args++;
+  a3->setName("a3");
+
+  // Create the entry block and other blocks
+  BasicBlock *entryBB =
+      BasicBlock::Create(m->getContext(), "entry", theFunction);
+  BasicBlock *outerLoopPreheaderBB =
+      BasicBlock::Create(m->getContext(), "outer_loop.preheader", theFunction);
+  BasicBlock *outerLoopBB =
+      BasicBlock::Create(m->getContext(), "outer_loop", theFunction);
+  BasicBlock *innerLoopBB =
+      BasicBlock::Create(m->getContext(), "inner_loop", theFunction);
+  BasicBlock *outerLoopBodyBB =
+      BasicBlock::Create(m->getContext(), "outer_loop.body", theFunction);
+  BasicBlock *returnBB =
+      BasicBlock::Create(m->getContext(), "return", theFunction);
+
+  // 入口
+  builder.SetInsertPoint(entryBB);
+  AllocaInst *jAlloca =
+      builder.CreateAlloca(builder.getInt32Ty(), nullptr, "jAlloca");
+  AllocaInst *iAlloca =
+      builder.CreateAlloca(builder.getInt32Ty(), nullptr, "iAlloca");
+  builder.CreateStore(builder.getInt32(0), iAlloca); // 初始i=0
+
+
+  Value *cmp = builder.CreateICmpSLE(a2, builder.getInt32(1), "cmp");
+  builder.CreateCondBr(cmp, returnBB, outerLoopPreheaderBB);
+
+  // 外部循环前导
+  builder.SetInsertPoint(outerLoopPreheaderBB);
+  builder.CreateBr(outerLoopBB);
+
+  // 外部循环
+  builder.SetInsertPoint(outerLoopBB);
+  builder.CreateStore(builder.getInt32(0), jAlloca); // 初始j=0
+  Value *firstElement =
+      builder.CreateLoad(ptrType, a1, "firstElement");
+  Value *firstByte =
+      builder.CreateTrunc(firstElement, builder.getInt8Ty(), "firstByte");
+  builder.CreateBr(innerLoopBB);
+
+  // 内部循环
+  builder.SetInsertPoint(innerLoopBB);
+  Value *jVal = builder.CreateLoad(builder.getInt32Ty(), jAlloca, "j");
+  Value *a1Idx = builder.CreateGEP(builder.getInt8Ty(), a1, jVal, "a1.idx");
+  Value *nextJVal = builder.CreateAdd(jVal, builder.getInt32(1), "j.next");
+  builder.CreateStore(nextJVal, jAlloca);
+  Value *a1IdxNext =
+      builder.CreateGEP(builder.getInt8Ty(), a1, nextJVal, "a1.idx.next");
+  Value *nextElement =
+      builder.CreateLoad(builder.getInt8Ty(), a1IdxNext, "nextElement");
+  builder.CreateStore(nextElement, a1Idx);
+  Value *jCmp = builder.CreateICmpSLT(nextJVal, a2, "j.cmp");
+  builder.CreateCondBr(jCmp, innerLoopBB, outerLoopBodyBB);
+
+  // 外循环体
+  builder.SetInsertPoint(outerLoopBodyBB);
+  Value *shiftedFirstByteI64 =
+      builder.CreateZExt(firstByte, builder.getInt8Ty(), "shiftedFirstByteI64");
+  Value *lastIndex = builder.CreateSub(a2, builder.getInt32(1), "lastIndex");
+  Value *a1LastPtr = builder.CreateGEP(builder.getInt8Ty(), a1, lastIndex, "a1.last.ptr");
+  builder.CreateStore(shiftedFirstByteI64, a1LastPtr);
+  Value *iVal = builder.CreateLoad(builder.getInt32Ty(), iAlloca, "i");
+  Value *nextIVal = builder.CreateAdd(iVal, builder.getInt32(1), "i.next");
+  builder.CreateStore(nextIVal, iAlloca); // 更新i的值
+  Value *exitCond = builder.CreateICmpEQ(nextIVal, a3, "exitcond");
+  builder.CreateCondBr(exitCond, returnBB, outerLoopBB);
+
+  // 返回
+  builder.SetInsertPoint(returnBB);
+  //Value *retVal = builder.CreateSelect(
+  //    cmp, builder.getInt64(0), builder.CreateZExt(a3, builder.getInt64Ty()),
+  //    "retVal");
+  //builder.CreateRet(retVal);
+  builder.CreateRetVoid();
+
+  //theFunction->print(outs());
+  return theFunction;
+}
+
+void VariableRotation::processFunction(Function &f,
+                                       const SetVector<Function *> &shift) {
+  SetVector<AllocaInst *> list;
+  for (BasicBlock &bb : f)
+    for (Instruction &instr : bb)
+      if (isa<AllocaInst>(instr)) {
+        auto a = (AllocaInst *)(&instr);
+        list.insert(a);
+      }
+  if (processVars(f, list, shift[0])) {
+    for (AllocaInst *a : list)
+      a->eraseFromParent();
+  }
+}
+
+bool VariableRotation::processVars(Function &f, SetVector<AllocaInst *> &vars,
+                                   Function *rotateFunc) {
+  if (vars.size() < 2)
+    return false;
+  IRBuilder<> irb(&*f.getEntryBlock().getFirstInsertionPt());
+  Value *zero = ConstantInt::get(irb.getInt32Ty(), 0);
+  const auto data = f.getParent()->getDataLayout();
+  int space = 0;
+  SetVector<int> value_map;
+  //printf("function: %s\n", f.getName().str().c_str());
+  for (const auto a : vars) {
+    value_map.insert(space);
+    //printf("address:  %d\n", space);
+    space += data.getTypeAllocSize(a->getAllocatedType());
+  }
+  ArrayType *array_type = ArrayType::get(irb.getInt8Ty(), space);
+  AllocaInst *array = irb.CreateAlloca(array_type);
+  for (BasicBlock &bb : f) {
+    int offset = 0;
+    auto iter = bb.getFirstInsertionPt();
+    if (&bb == &f.getEntryBlock())
+      ++iter;
+    while (iter != bb.end()) {
+      Instruction *inst = &*iter;
+      irb.SetInsertPoint(inst);
+      for (int i = 0; i < vars.size(); i++)
+        if (isUsedByInst(inst, vars[i])) {
+          if (constexpr int prob = 50;
+              cryptoutils->get_uint32_t() % 100 < prob) {
+            const int times =
+                cryptoutils->get_uint32_t() % (vars.size() - 1) + 1;
+            const int delta =
+                (space + value_map[(offset + times) % vars.size()] -
+                 value_map[offset]) %
+                space;
+            irb.CreateCall(
+                FunctionCallee(rotateFunc),
+                {irb.CreateGEP(array->getAllocatedType(), array, {zero, zero}),
+                 ConstantInt::get(irb.getInt32Ty(), space),
+                 ConstantInt::get(irb.getInt32Ty(), delta)});
+            offset = (offset + times) % vars.size();
+          }
+          const int index = (space + value_map[i] - value_map[offset]) % space;
+          Value *gep =
+              irb.CreateGEP(array->getAllocatedType(), array,
+                            {zero, ConstantInt::get(irb.getInt32Ty(), index)});
+          Value *cast = irb.CreateBitOrPointerCast(gep, vars[i]->getType());
+          int c = 0;
+          for (const Value *ops : inst->operands()) {
+            if (ops == vars[i])
+              inst->setOperand(c, cast);
+            c++;
+          }
+          break;
+        }
+      ++iter;
+    }
+    if (offset != 0) {
+      irb.SetInsertPoint(bb.getTerminator());
+      irb.CreateCall(
+          FunctionCallee(rotateFunc),
+          {irb.CreateGEP(array->getAllocatedType(), array, {zero, zero}),
+           ConstantInt::get(irb.getInt32Ty(), space),
+           ConstantInt::get(irb.getInt32Ty(),
+                            (space - value_map[offset]) % space)});
+    }
+  }
+  return true;
+}
+
+bool VariableRotation::isUsedByInst(Instruction *inst, const Value *var) {
+  if (std::any_of(inst->operands().begin(), inst->operands().end(),
+                  [&](const Value *in) { return in == var; })) {
+    return true;
+  }
+  return false;
+}
+
+bool VariableRotation::runOnModule(Module &m) {
+
+  Twine fname1 = Twine("shiftFuncitonI8");
+
+  Function *shiftFunc =
+      createRotateFunc(&m, Type::getInt8PtrTy(m.getContext()), fname1);
+
+  SetVector<Function *> shifts;
+
+  shifts.insert(shiftFunc);
+
+  for (Function &f : m) {
+
+    if (&f == shiftFunc)
+
+      continue;
+
+    if (f.hasExactDefinition())
+
+      processFunction(f, shifts);
+  }
+
+  return true;
+}
+
+}
+
+
+PreservedAnalyses VariableRotationPass::run(Module &M,
+                                            ModuleAnalysisManager &AM) {
+  if (RunVarRot) {
+    VariableRotation varObf;
+    if (varObf.runOnModule(M))
+      return PreservedAnalyses::none();
+  }
+  return PreservedAnalyses::all();
+}
