+/* ================== 本地 fmod/fmodf 替代（避免 -lm） ================== */
+static inline double vm_fmod(double x, double y) {
+  if (y == 0.0) return 0.0;
+  long long q = (long long)(x / y);
+  return x - (double)q * y;
+}
+static inline float vm_fmodf(float x, float y) {
+  if (y == 0.0f) return 0.0f;
+  int q = (int)(x / y);
+  return x - (float)q * y;
+}
