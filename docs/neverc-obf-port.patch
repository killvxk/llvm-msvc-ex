+// PORT-OBF: llvm/Demangle/Demangle.h does not exist in NeverC's vendored
+// LLVM (no Demangle library). isMemberFunction() below only used the
+// demangled name to look for "::" (C++ member functions); NeverC is a C
+// frontend, so the identity mapping preserves behaviour exactly.
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/InstIterator.h"
