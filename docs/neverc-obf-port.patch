+    case 0x02: return "LOAD";
+    case 0x03: return "STORE";
+    case 0x05: return "GEP";          /* 旧版：直接累加 index */
+    case 0x06: return "CMP";
+    case 0x07: return "CAST";
+    case 0x08: return "BR";
+    case 0x09: return "CALL";
+    case 0x0A: return "RET";
+    case 0x10: return "ARITH";
+    case 0x11: return "PARAMMAP";
+    case 0x12: return "SELECT";       /* 新增 */
+    case 0x13: return "GEP_SCALED";   /* 新增：带缩放 */
+    default:   return "UNKNOWN";
+  }
+}
