diff --git a/tests/port/examples.c b/tests/port/examples.c
new file mode 100644
index 000000000..e469ba417
--- /dev/null
+++ b/tests/port/examples.c
@@ -0,0 +1,98 @@
+/*
+ * tests/port/examples.c — 混淆子系统功能面示例（配套 docs/obfuscation-usage.md）。
+ * 覆盖：组合注解("fla bcf")、SVM 虚拟机("x-svm")、注解独占型 pass
+ * （ind-br / alias-access / custom-cc）、vm-fla，以及全局 flag 叠加用法。
+ *
+ * 基线: neverc -O1 -c tests/port/examples.c -o ex_base.o && neverc ex_base.o -o ex_base.exe
+ * 混淆: neverc -O1 -mllvm -string-obfus -mllvm -const-obfus -mllvm -mba-subs \
+ *            -mllvm -aesSeed=31337 -c tests/port/examples.c -o ex_obf.o && neverc ex_obf.o -o ex_obf.exe
+ * 判据: 两版运行 stdout 逐字节一致（内建自检退出码 0）。
+ * 可复现: 相同 aesSeed 二次编译，对象文件字节一致。
+ */
+#include <stdio.h>
+
+/* 组合注解：平坦化 + 虚假控制流（同一 annotate 串空格分隔） */
+__attribute__((annotate("fla bcf")))
+static int mix_cf(int x) {
+    int r = x;
+    if (x > 100)      r = r * 3 - 7;
+    else if (x > 10)  r = r + 41;
+    else              r = r ^ 0x5a;
+    for (int i = 0; i < 4; i++)
+        r = (r << 1) ^ (i + 1);
+    return r;
+}
+
+/* SVM 见下方 svm_style 说明（全局 flag 模式）。 */
+/* SVM 轻量虚拟机（注解独占；解释器内联生成，收养法修复后全链可用）。
+ * 注意：全局 -mllvm -x-svm 模式在 NeverC 上运行期会崩（会连 neverc
+ * 注入的 runtime 一起 VM 化），推荐注解模式逐函数使用。 */
+__attribute__((annotate("x-svm")))
+static int svm_style(int x) {
+    int acc = 1;
+    for (int i = 0; i < 5; i++)
+        acc = acc * (x + i) - i;
+    return acc;
+}
+
+/* 注解独占：间接跳转 */
+__attribute__((annotate("ind-br")))
+static int indirect_branch(int x) {
+    if (x < 0)        return -1;
+    else if (x == 0)  return 0;
+    else if (x < 64)  return x + 1;
+    return x - 1;
+}
+
+/* 注解独占：别名访问 */
+__attribute__((annotate("alias-access")))
+static int alias_user(int x) {
+    int a = x * 2, b = x + 9;
+    int *p = &a;
+    if (x & 1) p = &b;
+    *p += 3;
+    return a + b;
+}
+
+/* 注解独占：自定义调用约定（Obfu1-8，ISel 默认降级，行为不变） */
+__attribute__((annotate("custom-cc")))
+static int cc_odd(int a, int b) {
+    return a * 3 + b - (a ^ b);
+}
+
+/* VM 平坦化（vm-fla）注解在 NeverC 移植上暂有缺口：VMFlatten 产物在链接期
+ * bitcode 读取报 "Invalid record"（隔离定位实证，其余注解单独链接全过）。
+ * 修复后恢复本函数注解；详见 docs/obfuscation-usage.md 已知问题。 */
+static int vmfla_target(int x) {
+    switch (x & 3) {
+        case 0: return x * 10;
+        case 1: return x * 11;
+        case 2: return x * 12;
+        default: return x * 13;
+    }
+}
+
+/* 留给全局 flag 的对照函数（无注解，跟随 -mllvm 开关） */
+static int plain_arith(int a, int b) {
+    return (a + b) * (a - b) + (a | 5) - (b & 3);
+}
+
+int main(void) {
+    const int xs[] = {3, 17, 137, 0, -5, 41};
+    int total = 0;
+    for (int i = 0; i < 6; i++) {
+        int x = xs[i];
+        total += mix_cf(x) + svm_style(x) + indirect_branch(x)
+               + alias_user(x) + cc_odd(x, i) + vmfla_target(x)
+               + plain_arith(x, i);
+    }
+    printf("examples_total=%d\n", total);
+
+    /* 内建自检（期望值 = 基线实测，行为等价即两版一致） */
+    if (mix_cf(17) != mix_cf(17)) return 1;             /* 纯函数稳定性 */
+    if (svm_style(3) != svm_style(3)) return 2;
+    if (indirect_branch(0) != 0 || indirect_branch(-5) != -1) return 3;
+    if (cc_odd(7, 2) != 7 * 3 + 2 - (7 ^ 2)) return 4;
+    if (vmfla_target(6) != 6 * 12) return 5;
+    return 0;
+}
diff --git a/tests/port/smoke.c b/tests/port/smoke.c
new file mode 100644
index 000000000..b741cbb86
--- /dev/null
+++ b/tests/port/smoke.c
@@ -0,0 +1,54 @@
+/*
+ * tests/port/smoke.c — NeverC 混淆移植端到端冒烟（仿 llvm-msvc-ex tests/test_svm.c 结构）。
+ *
+ * 基线: neverc -O1 -c tests/port/smoke.c -o base.o
+ * 混淆: 按开关分支（-mllvm 透传 或 NEVERC_OBF_DEFAULT_ON）全开编译
+ * 判据:
+ *   1) 两版分别 link 运行，stdout 逐字节一致（行为等价）
+ *   2) 混淆版对象文件中明文字符串 "PORT_SMOKE_SECRET_MARKER_42" 消失（StringObfuscation）
+ *   3) 反汇编/IR 对比 classify 函数体结构差异可见（FLA dispatcher / SUB 替换）
+ */
+#include <stdio.h>
+
+/* 多分支 + 注解样例：FLA 平坦化目标 */
+__attribute__((annotate("fla")))
+static int classify(int x) {
+    int r = 0;
+    if (x < 10)        r = 1;
+    else if (x < 100)  r = 2;
+    else if (x < 1000) r = 3;
+    else               r = 4;
+    switch (x & 3) {
+        case 0:  r += 10; break;
+        case 1:  r += 20; break;
+        case 2:  r += 30; break;
+        default: r += 40; break;
+    }
+    return r;
+}
+
+/* 算术混合：SUB/MBA 替换目标 */
+__attribute__((annotate("sub")))
+static int arith(int a, int b) {
+    return (a + b) * 3 - (a ^ 5) + (b | 7);
+}
+
+/* 字符串常量：StringObfuscation 目标（判据 2 的探针） */
+static const char *secret_label = "PORT_SMOKE_SECRET_MARKER_42";
+
+int main(void) {
+    int total = 0;
+    for (int i = 0; i < 64; i++)
+        total += classify((i * 17) % 2048);
+    total += arith(total & 0xff, (total >> 3) & 0x7f);
+
+    printf("%s=%d\n", secret_label, total);
+
+    /* 内建自检（期望值手工核算：5<10&r=1,5&3=1→+20=21；50→r=2,+30=32；
+       500→r=3,500&3=0→+10=13；5000→r=4,+10=14） */
+    if (classify(5)    != 21) return 1;
+    if (classify(50)   != 32) return 2;
+    if (classify(500)  != 13) return 3;
+    if (classify(5000) != 14) return 4;
+    return 0;
+}
