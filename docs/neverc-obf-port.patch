+       OP_GEP=0x05, OP_CMP=0x06, OP_CAST=0x07,
+       OP_BR=0x08, OP_CALL=0x09, OP_RET=0x0A,
+       OP_ARITH=0x10, OP_PARAMMAP=0x11,
+       OP_SELECT=0x12, OP_GEP_SCALED=0x13 };
+
+enum { VT_CONST=0, VT_SLOT=1 };
+enum { CK_INT=0, CK_PTR=1, CK_F32=2, CK_F64=3 };
+
+enum { AR_ADD, AR_SUB, AR_MUL,
